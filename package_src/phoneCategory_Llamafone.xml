<?xml version="1.0" encoding="utf-8"?>
<I c="PieMenuCategory" i="pie_menu_category" m="interactions.pie_menu_category" n="phoneCategory_Llamafone" s="13371000010">
    <!--
        Top-level phone-home category for Llamafone. XML shape mirrors
        World Tour's phone-home tunings (thatssojordy_WorldTour_PieMenu,
        thatssojordy_CowTunes_PhoneMenu) which are confirmed working in
        the current game version. Two things to note vs. what a
        Sims4Studio autogen might produce:

        1. `_parent` is OMITTED entirely, NOT set to `t="disabled"`.
           Omitting means the category is a top-level phone-home tile;
           setting `t="disabled"` seems to fail some client filter that
           only PieMenuCategory subcategories are supposed to hit.

        2. `_icon` uses the flat `<T n="_icon">TYPE:GROUP:INSTANCE</T>`
           form, NOT the nested `<V><U><T n="key">` container. Both
           forms parse server-side, but the client-side ActionScript
           that renders the phone tile only recognises the flat form.

        _display_name is 0. We don't ship an STBL because previous
        attempts broke package loading. The Llamafone branding on the
        icon PNG carries the meaning without a text label.

        The _icon instance ID (0x62893b30f9952eee) is FNV-64 of the
        filename "llamafone_icon"; the package builder embeds
        llamafone_icon.png at that same instance ID so this
        reference resolves against our bundled PNG.
    -->
    <T n="_collapsible">False</T>
    <T n="_display_name">0</T>
    <T n="_display_priority">50</T>
    <T n="_icon" p="llamafone_icon.png">2f7d0004:00000000:62893b30f9952eee</T>
    <E n="_special_category">NO_CATEGORY</E>
</I>
